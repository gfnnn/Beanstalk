# Claude Code config: ship the shared SessionStart hook + settings, the committed
# slash commands, subagents and path-scoped rules, and the dev-server launch config,
# but keep personal/local overrides and transient state (incl. .claude/worktrees/)
# out of the repo.
.claude/*
!.claude/settings.json
!.claude/launch.json
!.claude/hooks/
!.claude/commands/
!.claude/agents/
!.claude/rules/
.claude/settings.local.json
# Private per-machine notes for Claude Code — never committed.
CLAUDE.local.md
.DS_Store
*.local
.env
.env.*
!.env.example
.dev.vars
.wrangler/
# Masters fetched from Dropbox by scripts/sync-dropbox-media.mjs — staging only;
# only the generated web tiers under public/images/ are committed.
.dropbox-cache/

# Private planning notes kept beside the checkout — never committed.
project-docs/

# Local logs and databases (wrangler dev, D1 exports)
*.log
*.sqlite
*.sqlite3
# D1 exports only (not *.sql: the migrations are .sql and are committed)
beansprout-*.sql
.dev.vars.*
